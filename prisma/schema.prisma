// Prisma Schema para Sistema de Gestión de Activos Fijos COMIBOL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMERACIONES
// ------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  FINISHED
  SUSPENDED
  CANCELLED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum DocumentType {
  PHOTO
  MANUAL
  INVOICE
  WARRANTY
  REPORT
  OTHER
}

// ------------------------------------------------------
// MODELOS
// ------------------------------------------------------

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  fullName   String
  profession String?
  role       String    @default("admin")
  isActive   Boolean   @default(true)
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  deliverAcquisitions  Acquisition[] @relation("UserDeliverAcquisitions")
  projectAcquisitions  Acquisition[] @relation("UserProjectAcquisitions")
  checkoutAcquisitions Acquisition[] @relation("UserCheckoutAcquisitions")

  @@map("users")
}

model AssetCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  usefulLife  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]

  @@map("asset_categories")
}

model AssetStatus {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]

  @@map("asset_statuses")
}

model Location {
  id          String    @id @default(uuid())
  parentId    String?
  name        String
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationHierarchy")

  assets Asset[]

  @@index([parentId])
  @@index([name])
  @@map("locations")
}

model Project {
  id          String        @id @default(uuid())
  name        String        @unique
  address     String?       @db.Text
  responsible String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  assetProjects      AssetProject[]
  supplyProjects     SupplyProject[]
  acquisitionDetails AcquisitionDetail[]

  @@index([name])
  @@index([status])
  @@map("projects")
}

model Asset {
  id            String    @id @default(uuid())
  code          String    @unique
  qrCode        String?   @unique
  name          String
  description   String?   @db.Text
  categoryId    String
  statusId      String
  locationId    String
  brand         String?
  model         String?
  serialNumber  String?   @unique
  unit          String?   @default("PZA")
  quantity      Int       @default(1)
  quantityOut   Int       @default(0) @map("quantity_out")
  purchaseDate  DateTime?
  purchaseYear  Int?
  purchaseValue Decimal?  @db.Decimal(12, 2)
  residualValue Decimal?  @db.Decimal(12, 2)
  currentValue  Decimal?  @db.Decimal(12, 2)
  observations  String?   @db.Text
  photo         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category AssetCategory @relation(fields: [categoryId], references: [id])
  status   AssetStatus   @relation(fields: [statusId], references: [id])
  location Location      @relation(fields: [locationId], references: [id])

  assetProjects AssetProject[]
  assignments   AssetAssignment[]
  documents     AssetDocument[]
  maintenances  AssetMaintenance[]

  @@index([code])
  @@index([qrCode])
  @@index([serialNumber])
  @@index([categoryId])
  @@index([statusId])
  @@index([locationId])
  @@index([purchaseDate])
  @@map("assets")
}

model AssetProject {
  id           String    @id @default(uuid())
  assetId      String
  projectId    String
  quantity     Int       @default(1)
  assignedAt   DateTime  @default(now())
  releasedAt   DateTime?
  observations String?   @db.Text

  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([projectId])
  @@map("asset_projects")
}

model AssetAssignment {
  id              String    @id @default(uuid())
  assetId         String
  responsibleName String
  position        String?
  assignedAt      DateTime  @default(now())
  returnedAt      DateTime?
  observations    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_assignments")
}

model AssetDocument {
  id           String       @id @default(uuid())
  assetId      String
  type         DocumentType @default(OTHER)
  fileName     String
  originalName String
  mimeType     String
  extension    String
  size         Int
  path         String
  description  String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_documents")
}

model AssetMaintenance {
  id              String          @id @default(uuid())
  assetId         String
  type            MaintenanceType @default(PREVENTIVE)
  maintenanceDate DateTime
  provider        String?
  cost            Decimal?        @db.Decimal(12, 2)
  nextMaintenance DateTime?
  observations    String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_maintenances")
}

model Supply {
  id             String    @id @default(uuid())
  name           String
  unit           String    @default("PZA")
  inputQuantity  Int       @default(0) @map("input_quantity")
  outputQuantity Int       @default(0) @map("output_quantity")
  entryDate      DateTime? @map("entry_date")
  observations   String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  supplyProjects SupplyProject[]

  @@map("supplies")
}

model SupplyProject {
  id           String   @id @default(uuid())
  supplyId     String   @map("supply_id")
  projectId    String   @map("project_id")
  quantity     Int      @default(1)
  observations String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  supply  Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([supplyId])
  @@index([projectId])
  @@map("supply_projects")
}

model Acquisition {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  projectUserId  String?   @map("project_user_id")
  checkoutUserId String?   @map("checkout_user_id")
  departureDate  DateTime? @map("departure_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User   @relation("UserDeliverAcquisitions", fields: [userId], references: [id])
  projectUser  User?  @relation("UserProjectAcquisitions", fields: [projectUserId], references: [id])
  checkoutUser User?  @relation("UserCheckoutAcquisitions", fields: [checkoutUserId], references: [id])

  details AcquisitionDetail[]

  @@index([userId])
  @@index([projectUserId])
  @@index([checkoutUserId])
  @@map("acquisitions")
}

model AcquisitionDetail {
  id            String   @id @default(uuid())
  acquisitionId String   @map("acquisition_id")
  projectId     String?  @map("project_id")
  unit          String?
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  acquisition Acquisition @relation(fields: [acquisitionId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([acquisitionId])
  @@index([projectId])
  @@map("acquisition_details")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
