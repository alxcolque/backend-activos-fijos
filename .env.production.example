# Entorno de Producción
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://comibol_user:ComibolDbPass2026!@mysql:3306/activos_fijos

# Configuración MySQL Docker
MYSQL_ROOT_PASSWORD=SecretPassword2026!
MYSQL_DATABASE=activos_fijos
MYSQL_USER=comibol_user
MYSQL_PASSWORD=ComibolDbPass2026!

# JWT Tokens
JWT_SECRET=CAMBIAR_POR_SECRET_COMPLEJO_ALEATORIO_Y_LARGO_2026
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Almacenamiento
UPLOAD_PATH=/app/uploads
MAX_UPLOAD_SIZE=10485760

# Seguridad & Swagger
CORS_ORIGIN=https://activos.comibol.gob.bo
ENABLE_SWAGGER=false
TZ=America/La_Paz
