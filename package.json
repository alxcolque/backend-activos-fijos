{
  "name": "backend-activos-fijos",
  "version": "1.0.0",
  "description": "API REST para el Sistema de Gestión de Activos Fijos COMIBOL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "build:prod": "node scripts/build-prod.js",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "seed": "prisma db seed",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "backup": "sh ./scripts/backup.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "comibol",
    "activos-fijos",
    "fastify",
    "prisma",
    "mysql",
    "typescript",
    "docker"
  ],
  "author": "COMIBOL",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.15",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.12",
    "docx": "^9.7.1",
    "docx-templates": "^4.15.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "typescript": "^5.5.4",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.17.0"
  }
}
